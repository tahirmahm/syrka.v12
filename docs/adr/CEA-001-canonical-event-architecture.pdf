T*
(    Raw --> Mapper[Canonical Mapper]) Tj
T*
(    Mapper --> Validate[Schema/Domain Validation]) Tj
T*
(    Validate --> Idem[Idempotency Check]) Tj
T*
(    Idem --> Publish[Publish Canonical Event]) Tj
ET
endstream
