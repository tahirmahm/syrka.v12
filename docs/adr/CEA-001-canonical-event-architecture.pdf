(| Identity | identity_id |) Tj
T*
(| Learning/assessment | student_id or student_id:course_id |) Tj
T*
(| Capability | subject_id:capability_id |) Tj
T*
(| Passport | passport_id |) Tj
T*
(| Credential | credential_id |) Tj
