# Supabase — required to compile pages that query the legacy National
# Human Capital Intelligence product (e.g. app/page.tsx, app/[country]/*).
# The Syrka Campus frontend uses typed mock data and does not require these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers used by legacy ministry/student API routes.
OPENAI_API_KEY=
# DEEPSEEK_API_KEY is also used by Syrka Campus Odyssey (lib/services/odyssey/deepseek-provider.ts)
# for real AI-assisted roadmap generation/replanning. Server-side only — never expose via
# NEXT_PUBLIC_*, never read from a client component. When unset, Odyssey falls back to its
# deterministic typed demonstration plan; the rest of Syrka Campus is unaffected either way.
DEEPSEEK_API_KEY=
# Optional — overrides the DeepSeek model used for Odyssey generation/replanning
# (lib/services/odyssey/provider.ts). Defaults to "deepseek-chat" if unset.
ODYSSEY_DEEPSEEK_MODEL=

# Legacy service/integration configuration.
NEXT_PUBLIC_APP_URL=
CRON_SECRET=
SEED_SECRET=
MIROFISH_URL=
OPENALEX_MAILTO=
