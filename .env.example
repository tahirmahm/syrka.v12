# AI providers used by legacy ministry/student API routes.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Legacy service/integration configuration.
NEXT_PUBLIC_APP_URL=
CRON_SECRET=
SEED_SECRET=
MIROFISH_URL=
OPENALEX_MAILTO=
