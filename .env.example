# Supabase — required to compile pages that query the legacy National
# Human Capital Intelligence product (e.g. app/page.tsx, app/[country]/*).
# The Syrka Campus frontend uses typed mock data and does not require these.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI providers used by legacy ministry/student API routes.
OPENAI_API_KEY=
# DEEPSEEK_API_KEY is also used by Syrka Campus Odyssey (lib/services/odyssey/deepseek-provider.ts)
# for real AI-assisted roadmap generation/replanning. Server-side only — never expose via
# NEXT_PUBLIC_*, never read from a client component. When unset, Odyssey falls back to its
# deterministic typed demonstration plan; the rest of Syrka Campus is unaffected either way.
DEEPSEEK_API_KEY=
# Optional — overrides the DeepSeek model used for Odyssey generation/replanning
# (lib/services/odyssey/provider.ts). Accepts "deepseek-v4-flash" (default if
# unset) or "deepseek-v4-pro" for deliberately stronger reasoning. A legacy
# value ("deepseek-chat"/"deepseek-reasoner", retired 2026-07-24) is
# normalised automatically by resolveDeepSeekModel() (lib/deepseek.ts) with a
# dev-only console warning — update this value directly when you see it.
ODYSSEY_DEEPSEEK_MODEL=
# Optional, non-production only — when "true", /api/odyssey/generate and
# /api/odyssey/replan honor a `simulate` field in the request body
# (lib/services/odyssey/simulate.ts) to deterministically exercise malformed/
# unknown-reference/circular-prerequisite/timeout/unavailable/rate-limit
# failure paths without touching the real DeepSeek key. Never set in a real
# production environment.
ODYSSEY_ALLOW_SIMULATION=

# LEARN-002 — Desmos-powered Learning graphs (DesmosLearningGraph,
# components/learning/visuals/DesmosLearningGraph.tsx). Public by necessity
# (the Desmos calculator script is loaded client-side), so only ever set to a
# key scoped/rate-limited for this purpose — never a secret credential. When
# unset, every Desmos-backed visual renders an honest "unavailable" state and
# falls back to its structured table/text equivalent; nothing else in Syrka
# Campus is affected.
NEXT_PUBLIC_DESMOS_API_KEY=

# Legacy service/integration configuration.
NEXT_PUBLIC_APP_URL=
CRON_SECRET=
SEED_SECRET=
MIROFISH_URL=
OPENALEX_MAILTO=
